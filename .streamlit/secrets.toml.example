# Copy these lines into your app's Secrets on Streamlit Cloud (app menu -> Settings -> Secrets).
# Never put the real values in this file or commit a secrets.toml.
[admin]
username = "your-name"
password = "a long password only you know"
name = "Your Name"

# Permanent accounts: without this, every account except the admin above (and everyone's saved
# strategies) is lost whenever the app restarts, because Streamlit Cloud wipes its disk.
# 1. Create a new PRIVATE repository on GitHub, e.g. backtest-studio-data (leave it empty).
# 2. GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens ->
#    Generate new token. Repository access: "Only select repositories" -> that repository.
#    Permissions -> Repository -> Contents: "Read and write". Copy the token.
[storage]
repo = "your-github-name/backtest-studio-data"
token = "github_pat_..."
